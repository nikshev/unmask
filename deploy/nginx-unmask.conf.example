# Приклад конфігу зворотного проксі для unmask (FR-008-12, R-10).
#
# Плейсхолдери: замініть example.com на свій домен і шляхи сертифікатів
# (certbot створює їх у /etc/letsencrypt/live/<домен>/). Секретів тут немає.
#
# Поки прапорця --host немає в юніті, сервер unmask слухає 0.0.0.0:18080, і порт 18080
# має бути закритий фаєрволом зовні (наприклад, `ufw deny 18080`). Після появи --host
# у deploy/unmask.service (задача T-167) застосунок слухатиме 127.0.0.1, і тоді
# фаєрвол уже не потрібен, бо ззовні його не видно.
#
# Довірені адреси проксі задаються в config/protection.yaml (proxy.trusted: 127.0.0.1, ::1).
# Застосунок бере адресу клієнта з X-Forwarded-For лише тоді, коли з'єднання йде з однієї
# з цих адрес. Тому тут заголовок ПЕРЕЗАПИСУЄТЬСЯ адресою з'єднання ($remote_addr), а не
# доклеюється: інакше клієнт міг би підставити власну адресу на початок ланцюга.
#
# proxy_read_timeout 660s: холодний аналіз триває до time_budget_seconds (600 с, config/ingest.yaml),
# тож таймаут має перевищувати бюджет із запасом. Типове 60 с nginx давало б 504 на кожен холодний запит.
#
# Версії nginx: `listen 443 ssl http2;` працює на nginx 1.24 (Ubuntu 24.04) і на новіших.
# Окрема директива `http2 on;` є лише з 1.25.1, на 1.24 вона дає `unknown directive`.

# Порт 80: лише перенаправлення на HTTPS. Незашифрованого шляху до API немає.
server {
    listen 80;
    server_name example.com;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name example.com;

    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:18080;

        proxy_set_header Host $host;
        # Перезапис, не додавання: адреса клієнта береться лише з з'єднання nginx.
        proxy_set_header X-Forwarded-For $remote_addr;

        proxy_read_timeout 660s;
        proxy_send_timeout 660s;
    }
}
