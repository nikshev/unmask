# Шаблон. Скопіюйте в .env і заповніть; сам .env у git не потрапляє.
# URL Solana RPC разом із API-ключем (за PRD — RPC Fast): https://<хост>/<ключ>
UNMASK_RPC_URL=
# Другий (необов'язковий) RPC для порівняння (напр. Alchemy/Helius з архівною історією):
UNMASK_RPC_URL_ALT=
# Додаткові (необов'язкові) провайдери пулу; імена мають збігатися з config/rpc_pool.yaml (url_env):
UNMASK_RPC_URL_ALT1=
UNMASK_RPC_URL_ALT2=
